# Backend API Configuration
# Copy this file to .env and update with your network IP address

# For Android Emulator: http://10.0.2.2:4000
# For iOS Simulator: http://localhost:4000
# For Physical Device: http://YOUR_COMPUTER_IP:4000
# Find your IP: Run "a" (Windows) or "ifconfig" (Mac/Linux)

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.120:4000
# WebSocket URL for real-time STT streaming (must match backend port)
EXPO_PUBLIC_WS_BASE_URL=ws://192.168.1.120:4000